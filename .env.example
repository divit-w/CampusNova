# Docker Compose local configuration. Copy to .env for local container runs only.
ENVIRONMENT=development
MONGO_URI=mongodb://host.docker.internal:27017
MONGO_DB_NAME=campusnova
SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-32-characters
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CHROMA_PERSIST_DIR=/app/runtime/chroma
UPLOADS_DIR=/app/runtime/uploads
SEED_DEMO_DATA=false
