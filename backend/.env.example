# Local development only. Copy to backend/.env; never commit the copied file.
# Production values belong in your hosting provider's secret manager.
ENVIRONMENT=development
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=campusnova
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=0
SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=11520
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CHROMA_PERSIST_DIR=./runtime/chroma
UPLOADS_DIR=./runtime/uploads
MAX_UPLOAD_SIZE_MB=10
SEED_DEMO_DATA=false
OPENROUTER_API_KEY=
GEMINI_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small
LOG_LEVEL=INFO
GOOGLE_CLIENT_ID=
CAMPUS_LAT=28.6304
CAMPUS_LON=77.3711
GEOFENCE_RADIUS_METERS=500
